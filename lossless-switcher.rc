#define RT_MANIFEST 24
1 RT_MANIFEST "app.manifest"
1 ICON "assets/app.ico"

1 VERSIONINFO
FILEVERSION 0,3,5,0
PRODUCTVERSION 0,3,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Pratama Putra\0"
            VALUE "FileDescription", "RateAlign\0"
            VALUE "FileVersion", "0.3.5.0\0"
            VALUE "InternalName", "RateAlign\0"
            VALUE "OriginalFilename", "RateAlign.exe\0"
            VALUE "ProductName", "RateAlign\0"
            VALUE "ProductVersion", "0.3.5\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Pratama Putra. GPL-3.0-only.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
